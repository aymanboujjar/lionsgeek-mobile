{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_EVENTS_INFO_SECTION_URL": "https://lionsgeek.ma/",
        "EXPO_PUBLIC_EVENTS_INFO_USE_PROXY": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
